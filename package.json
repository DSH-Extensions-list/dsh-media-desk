{
  "name": "dsh-media-desk",
  "version": "3.1.2",
  "description": "A DeepSeek Harness plugin for Instagram, X and Reddit. Capture an idea in one line, then draft the spoken script, title, video cover, images and storyboard in one click.",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "reddit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSH-Extensions-list/dsh-media-desk.git"
  },
  "homepage": "https://github.com/DSH-Extensions-list/dsh-media-desk#readme",
  "bugs": "https://github.com/DSH-Extensions-list/dsh-media-desk/issues",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "assets": "python3 scripts/gen-assets.py",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
